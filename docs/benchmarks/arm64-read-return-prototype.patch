+#if C_TARGET_CPU_ARM
+// AAPCS64 returns this pair in x0/x1: value and checked-access failure.
+// Keep handler/page-crossing behavior in the original checked helpers. Only
+// direct cached reads avoid the scratch-result store and generated reload.
+struct DynrecReadResult { uint64_t value; uint64_t fault; };
+[[gnu::noinline]] static DynrecReadResult mem_readb_result_slow(PhysPt address) {
+    const bool fault = mem_readb_checked_drc(address);
+    return {core_dynrec.readdata & 0xffu, uint64_t(fault)};
+}
+[[gnu::noinline]] static DynrecReadResult mem_readw_result_slow(PhysPt address) {
+    const bool fault = mem_readw_checked_drc(address);
+    return {core_dynrec.readdata & 0xffffu, uint64_t(fault)};
+}
+[[gnu::noinline]] static DynrecReadResult mem_readd_result_slow(PhysPt address) {
+    const bool fault = mem_readd_checked_drc(address);
+    return {uint32_t(core_dynrec.readdata), uint64_t(fault)};
+}
+static DynrecReadResult mem_readb_result_drc(PhysPt address) {
+    if (HostPt p = get_tlb_read(address)) return {host_readb(p + address), 0};
+    return mem_readb_result_slow(address);
+}
+static DynrecReadResult mem_readw_result_drc(PhysPt address) {
+    if ((address & 0xfff) < 0xfff)
+        if (HostPt p = get_tlb_read(address)) return {host_readw(p + address), 0};
+    return mem_readw_result_slow(address);
+}
+static DynrecReadResult mem_readd_result_drc(PhysPt address) {
+    if ((address & 0xfff) < 0xffd)
+        if (HostPt p = get_tlb_read(address)) return {host_readd(p + address), 0};
+    return mem_readd_result_slow(address);
+}
+#endif
