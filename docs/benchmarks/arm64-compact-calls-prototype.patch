+// Experimental compact calls. Patchable arithmetic calls retain five words.
+static void inline gen_call_memory_function(void * func) {
+    const auto target = reinterpret_cast<uintptr_t>(func);
+    const auto source = reinterpret_cast<uintptr_t>(cache.pos);
+    const int64_t pages = static_cast<int64_t>(target >> 12) -
+                          static_cast<int64_t>(source >> 12);
+    if (pages >= -(int64_t{1} << 20) && pages < (int64_t{1} << 20)) {
+        const auto imm = static_cast<uint32_t>(pages) & 0x1fffffu;
+        cache_addd(0x90000000u | ((imm & 3u) << 29) |
+                   ((imm >> 2) << 5) | temp1); // adrp xTemp, target page
+        cache_addd(0x91000000u | ((target & 0xfffu) << 10) |
+                   (temp1 << 5) | temp1); // add xTemp, xTemp, page offset
+        cache_addd(BLR_REG(temp1));
+    } else {
+        gen_call_function_raw(func);
+    }
+}
