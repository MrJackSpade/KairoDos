+// Only checked-memory calls are non-patchable; arithmetic raw calls must
+// retain the five-word layout used by deferred flags invalidation.
+static void dyn_call_memory_function(void* function) {
+#if C_TARGET_CPU_ARM
+    gen_call_memory_function(function);
+#else
+    gen_call_function_raw(function);
+#endif
+}
