+++ b/backend-dos/src/main/cpp/kairo_dispatch_profile.h
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#ifdef KAIRO_GUEST_PROFILE
+#include "cpu/cpu.h"
+#include <cstdio>
+#include <cstdint>
+#include <ctime>
+#include <cstring>
+#include <string>
+namespace kairo_dispatch_profile {
+inline FILE* output=nullptr;
+inline uint64_t last_flush=0,entries=0;
+inline uint64_t counts[18]={},returns[16]={},opcodes[5120]={},normal_calls[5]={},clears[8]={};
+inline unsigned normal_reason=0,clear_reason=0;
+inline uint64_t now(){timespec t{};clock_gettime(CLOCK_MONOTONIC,&t);return uint64_t(t.tv_sec)*1000000000ull+t.tv_nsec;}
+inline void close(){if(output){std::fclose(output);output=nullptr;}}
+inline void open(const std::string& dir){
+ close();last_flush=entries=0;normal_reason=clear_reason=0;
+ std::memset(counts,0,sizeof counts);std::memset(returns,0,sizeof returns);std::memset(opcodes,0,sizeof opcodes);std::memset(normal_calls,0,sizeof normal_calls);std::memset(clears,0,sizeof clears);
+ FILE* marker=std::fopen((dir+"/kairo-dispatch-profile.enable").c_str(),"rb");if(!marker)return;std::fclose(marker);
+ output=std::fopen((dir+"/kairo-dispatch-profile.jsonl").c_str(),"wb");
+}
+inline void count(unsigned n){if(output)++counts[n];}
+inline void returned(unsigned n){if(output&&n<16)++returns[n];}
+inline void normal_entry(){if(output)++normal_calls[normal_reason];}
+inline void opcode(unsigned n){if(output&&n<1024)++opcodes[normal_reason*1024+n];}
+inline Bits normal(unsigned why){
+ if(!output)return CPU_Core_Normal_Run();
+ const auto old=normal_reason;normal_reason=why;const auto result=CPU_Core_Normal_Run();normal_reason=old;return result;
+}
+struct ClearContext{unsigned old;explicit ClearContext(unsigned n):old(clear_reason){clear_reason=n;}~ClearContext(){clear_reason=old;}};
+inline void clear(bool primary){if(output)++clears[clear_reason*2+(primary?0:1)];}
+template<typename T,size_t N> inline void array(const char* name,const T(&values)[N]){
+ std::fprintf(output,",\"%s\":[",name);for(size_t i=0;i<N;++i)std::fprintf(output,"%s%llu",i?",":"",static_cast<unsigned long long>(values[i]));std::fputs("]",output);
+}
+inline void flush(){
+ if(!output)return;const auto t=now();if(t-last_flush<1000000000ull)return;last_flush=t;
+ std::fprintf(output,"{\"time\":%llu,\"entries\":%llu",static_cast<unsigned long long>(t),static_cast<unsigned long long>(entries));
+ array("counts",counts);array("returns",returns);array("normalCalls",normal_calls);array("opcodes",opcodes);array("clears",clears);
+ std::fputs("}\n",output);std::fflush(output);
+}
+}
+#define KAIRO_DISPATCH_COUNT(n) kairo_dispatch_profile::count(n)
+#define KAIRO_DISPATCH_NORMAL(n) kairo_dispatch_profile::normal(n)
+#else
+#define KAIRO_DISPATCH_COUNT(n) ((void)0)
+#define KAIRO_DISPATCH_NORMAL(n) CPU_Core_Normal_Run()
+#endif
