--- /dev/null
+++ b/backend-dos/src/main/cpp/kairo_slice_profile.h
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#ifdef KAIRO_GUEST_PROFILE
+#include "cpu/cpu.h"
+#include "hardware/pic.h"
+#include <cstdio>
+#include <cstdint>
+#include <ctime>
+#include <cstring>
+#include <string>
+namespace kairo_slice_profile {
+inline FILE* output=nullptr;
+inline uint64_t last_flush=0;
+inline uint64_t slices[160]={},blocks[128]={},flags[192]={};
+inline uint64_t entry[20]={},remaining[20]={},consumed[20]={};
+inline int64_t budget_sum[2]={},remaining_sum[2]={},cycle_left_delta[2]={};
+inline unsigned state(){return (!!GETFLAG(IF)) | ((!!PIC_IRQCheck)<<1) | ((!!GETFLAG(TF))<<2);}
+inline unsigned bucket(int64_t n){if(n<=0)return 0;if(n<=1)return 1;if(n<=4)return 2;if(n<=16)return 3;if(n<=64)return 4;if(n<=256)return 5;if(n<=1024)return 6;if(n<=4096)return 7;if(n<=16384)return 8;return 9;}
+inline uint64_t now(){timespec t{};clock_gettime(CLOCK_MONOTONIC,&t);return uint64_t(t.tv_sec)*1000000000ull+t.tv_nsec;}
+inline void close(){if(output){std::fclose(output);output=nullptr;}}
+inline void open(const std::string& dir){
+ close();last_flush=0;
+ std::memset(slices,0,sizeof slices);std::memset(blocks,0,sizeof blocks);std::memset(flags,0,sizeof flags);
+ std::memset(entry,0,sizeof entry);std::memset(remaining,0,sizeof remaining);std::memset(consumed,0,sizeof consumed);
+ std::memset(budget_sum,0,sizeof budget_sum);std::memset(remaining_sum,0,sizeof remaining_sum);std::memset(cycle_left_delta,0,sizeof cycle_left_delta);
+ FILE* marker=std::fopen((dir+"/kairo-slice-profile.enable").c_str(),"rb");if(!marker)return;std::fclose(marker);
+ output=std::fopen((dir+"/kairo-slice-profile.jsonl").c_str(),"wb");
+}
+struct Slice {
+ unsigned kind,reason=0;int before=0,left=0;bool enabled;
+ explicit Slice(unsigned k):kind(k),enabled(output!=nullptr){if(enabled){before=CPU_Cycles;left=CPU_CycleLeft;}}
+ ~Slice(){if(enabled){++slices[(kind*10+reason)*8+state()];++entry[kind*10+bucket(before)];++remaining[kind*10+bucket(CPU_Cycles)];++consumed[kind*10+bucket(int64_t(before)-CPU_Cycles)];budget_sum[kind]+=before;remaining_sum[kind]+=CPU_Cycles;cycle_left_delta[kind]+=int64_t(CPU_CycleLeft)-left;}}
+};
+struct Flag {
+ unsigned op,before=0;bool enabled;
+ explicit Flag(unsigned o):op(o),enabled(output!=nullptr){if(enabled)before=state();}
+ ~Flag(){if(enabled)++flags[op*64+before*8+state()];}
+};
+inline void block(unsigned result){if(output&&result<16)++blocks[result*8+state()];}
+template<typename T,size_t N> inline void array(const char* name,const T(&values)[N]){
+ std::fprintf(output,",\"%s\":[",name);for(size_t i=0;i<N;++i)std::fprintf(output,"%s%lld",i?",":"",static_cast<long long>(values[i]));std::fputs("]",output);
+}
+inline void flush(){
+ if(!output)return;const auto t=now();if(t-last_flush<1000000000ull)return;last_flush=t;
+ std::fprintf(output,"{\"time\":%llu",static_cast<unsigned long long>(t));
+ array("slices",slices);array("blocks",blocks);array("flags",flags);array("entry",entry);array("remaining",remaining);array("consumed",consumed);array("budgetSum",budget_sum);array("remainingSum",remaining_sum);array("cycleLeftDelta",cycle_left_delta);
+ std::fputs("}\n",output);std::fflush(output);
+}
+}
+#endif
