new file mode 100644
--- /dev/null
+++ b/backend-dos/src/main/cpp/kairo_memory_profile.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#ifdef KAIRO_GUEST_PROFILE
+#include <cstdio>
+#include <cstdint>
+#include <ctime>
+#include <string>
+#include <cstring>
+namespace kairo_memory_profile {
+inline FILE* output = nullptr;
+inline uintptr_t ram_begin=0, ram_end=0;
+inline uint64_t counts[6][4] = {}, faults[6] = {}, handler_flags[6][128] = {};
+inline uint64_t last_flush=0;
+inline uint64_t now() { timespec t{}; clock_gettime(CLOCK_MONOTONIC,&t); return uint64_t(t.tv_sec)*1000000000ull+t.tv_nsec; }
+inline void close() { if(output){std::fclose(output);output=nullptr;} }
+inline void open(const std::string& dir) {
+ close(); ram_begin=ram_end=last_flush=0;
+ std::memset(counts,0,sizeof(counts));std::memset(faults,0,sizeof(faults));std::memset(handler_flags,0,sizeof(handler_flags));
+ FILE* marker=std::fopen((dir+"/kairo-memory-profile.enable").c_str(),"rb");
+ if(!marker)return;std::fclose(marker);
+ output=std::fopen((dir+"/kairo-memory-profile.jsonl").c_str(),"wb");
+}
+inline void set_ram(const void* base,size_t bytes) {
+ if(output&&!ram_begin){ram_begin=reinterpret_cast<uintptr_t>(base);ram_end=ram_begin+bytes;}
+}
+inline void direct(unsigned op,const void* ptr) {
+ if(output){const auto p=reinterpret_cast<uintptr_t>(ptr);++counts[op][p>=ram_begin&&p<ram_end?0:1];}
+}
+inline void handler(unsigned op,unsigned flags) {if(output){++counts[op][2];++handler_flags[op][flags&127];}}
+inline void crossing(unsigned op) {if(output)++counts[op][3];}
+inline void fault(unsigned op,bool failed) {if(output&&failed)++faults[op];}
+inline void flush() {
+ if(!output)return;const auto time=now();if(time-last_flush<1000000000ull)return;last_flush=time;
+ std::fprintf(output,"{\"time\":%llu,\"counts\":[",(unsigned long long)time);
+ for(unsigned i=0;i<6;++i){std::fprintf(output,"%s[",i?",":"");for(unsigned j=0;j<4;++j)std::fprintf(output,"%s%llu",j?",":"",(unsigned long long)counts[i][j]);std::fputs("]",output);}
+ std::fputs("],\"faults\":[",output);for(unsigned i=0;i<6;++i)std::fprintf(output,"%s%llu",i?",":"",(unsigned long long)faults[i]);
+ std::fputs("],\"handlerFlags\":[",output);
+ for(unsigned i=0;i<6;++i){std::fprintf(output,"%s[",i?",":"");for(unsigned j=0;j<128;++j)std::fprintf(output,"%s%llu",j?",":"",(unsigned long long)handler_flags[i][j]);std::fputs("]",output);}
+ std::fputs("]}\n",output);std::fflush(output);
+}
+}
+#define KAIRO_MEM_DIRECT(op,ptr) kairo_memory_profile::direct(op,ptr)
+#define KAIRO_MEM_HANDLER(op,flags) kairo_memory_profile::handler(op,flags)
+#define KAIRO_MEM_CROSS(op) kairo_memory_profile::crossing(op)
+#define KAIRO_MEM_FAULT(op,value) kairo_memory_profile::fault(op,value)
+#else
+#define KAIRO_MEM_DIRECT(op,ptr) ((void)0)
+#define KAIRO_MEM_HANDLER(op,flags) ((void)0)
+#define KAIRO_MEM_CROSS(op) ((void)0)
+#define KAIRO_MEM_FAULT(op,value) ((void)0)
+#endif
